OMAI_ENV=development
OMAI_ADDR=127.0.0.1:8787
OMAI_METRICS_ADDR=127.0.0.1:9091
OMAI_WORKSPACE_ROOTS=/absolute/path/to/workspaces
OMAI_DEV_TOKEN=replace-with-at-least-32-random-characters
OMAI_ALLOWED_ORIGINS=http://localhost:4444
OMAI_ENABLE_REFLECTION=true
OMAI_ENABLE_DEMO_RUNTIME=true
OMAI_RUNTIMES_FILE=./configs/runtimes.example.json
OMAI_MODEL_CATALOG_FILE=./configs/models.example.json
# Full vendored models.dev snapshot plus hourly atomic live refresh.
OMAI_MODEL_SYNC_FILE=./configs/model-sync.example.json
OMAI_PROCESS_BUFFER=4194304
OMAI_MAX_PROCESSES_PER_TENANT=32
OMAI_LOG_LEVEL=info

# Go-owned dev-server detection, lifecycle and capability gateway.
OMAI_PREVIEW_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Recommended for HMR when wildcard localhost DNS is supported:
# OMAI_PREVIEW_PUBLIC_URL_TEMPLATE=http://{id}.preview.localhost:8787/
OMAI_PREVIEW_BIND_HOST=127.0.0.1
OMAI_PREVIEW_RUNTIME_HOST=127.0.0.1
# Change to auto only when execution is isolated or the workspace is trusted.
OMAI_PREVIEW_PREPARATION=never
OMAI_PREVIEW_PREPARATION_TIMEOUT=5m
OMAI_PREVIEW_STARTUP_TIMEOUT=45s
OMAI_PREVIEW_IDLE_TIMEOUT=30m

# Private Go control-plane -> workspace sandbox connection. Development may
# use cleartext loopback/container networking. Production requires HTTPS mTLS.
OMAI_EXECUTOR_URL=http://127.0.0.1:8792
OMAI_EXECUTOR_TOKEN=replace-with-a-different-32-character-executor-token
OMAI_EXECUTOR_TRANSPORT=grpc
# OMAI_EXECUTOR_CA_CERT=/run/secrets/executor-ca.crt
# OMAI_EXECUTOR_CLIENT_CERT=/run/secrets/control-plane.crt
# OMAI_EXECUTOR_CLIENT_KEY=/run/secrets/control-plane.key
# OMAI_EXECUTOR_TLS_SERVER_NAME=workspace-executor.internal

# Leaf executor configuration. Production provisions one tenant/workspace per
# OpenSandbox/Firecracker instance and requires TLS cert/key plus client CA.
OMAI_EXECUTOR_ENV=development
OMAI_EXECUTOR_ADDR=127.0.0.1:8792
OMAI_EXECUTOR_WORKSPACE_ROOT=/absolute/path/to/one/workspace
OMAI_EXECUTOR_ALLOW_INSECURE=false
OMAI_EXECUTOR_ENABLE_REFLECTION=true
OMAI_EXECUTOR_MAX_COMMAND_OUTPUT=16777216
OMAI_EXECUTOR_COMMAND_TIMEOUT=2m
# OMAI_EXECUTOR_TENANT_ID=tenant-id
# OMAI_EXECUTOR_WORKSPACE_ID=wsp_id
# OMAI_EXECUTOR_TLS_CERT=/run/secrets/executor.crt
# OMAI_EXECUTOR_TLS_KEY=/run/secrets/executor.key
# OMAI_EXECUTOR_CLIENT_CA=/run/secrets/control-plane-ca.crt

# Optional coding-harness runtime hosted by the same leaf executor. The model
# edge is loopback-only; the harness receives a per-turn capability instead of
# a provider key. HOME/state must be outside the assigned agent workspace.
# OMAI_HARNESS_DRIVER=opencode
# OMAI_HARNESS_COMMAND=/usr/local/bin/opencode
# OMAI_HARNESS_COMMAND_ARGS=[]
# OMAI_HARNESS_VERSION=pinned-release-or-image-digest
# OMAI_HARNESS_HOME=/var/lib/omai/harness
# OMAI_HARNESS_STATE_FILE=/var/lib/omai/harness/sessions.json
# OMAI_HARNESS_MODEL_EDGE_ADDR=127.0.0.1:8793
# OMAI_HARNESS_AUTO_APPROVE=false
# OMAI_HARNESS_MAX_EVENT_BYTES=4194304
# OMAI_HARNESS_MAX_STDERR_BYTES=1048576
# OMAI_HARNESS_MODEL_LEASE_TTL=2h
# OMAI_HARNESS_MODEL_GATEWAY_URL=http://127.0.0.1:8790
# OMAI_HARNESS_MODEL_GATEWAY_TOKEN=replace-with-the-adk-runtime-token
# OMAI_HARNESS_MODEL_GATEWAY_TRANSPORT=grpc
# OMAI_HARNESS_MODEL_GATEWAY_CA_CERT=/run/secrets/adk-ca.crt
# OMAI_HARNESS_MODEL_GATEWAY_CLIENT_CERT=/run/secrets/executor-adk.crt
# OMAI_HARNESS_MODEL_GATEWAY_CLIENT_KEY=/run/secrets/executor-adk.key
# OMAI_HARNESS_MODEL_GATEWAY_TLS_SERVER_NAME=adk.internal
OMAI_SERVICE_TOKEN=replace-with-a-different-32-character-service-token
OMAI_REDIS_ADDR=127.0.0.1:6379
OMAI_VOICE_TICKET_TTL=30s
OMAI_VOICE_LEASE_TTL=45s
OMAI_VOICE_MAX_SESSIONS_PER_ACTOR=2

# Separately deployed Go ADK 2.2 model runtime. Provider keys remain here and
# are never sent to the browser or coding harnesses.
OMAI_ADK_ADDR=127.0.0.1:8790
OMAI_ADK_ENV=development
# Only private development container networks may explicitly opt into
# cleartext. Production ignores this escape hatch and requires mTLS.
OMAI_ADK_ALLOW_INSECURE=false
OMAI_ADK_RUNTIME_TOKEN=replace-with-a-different-32-character-runtime-token
OMAI_RUNTIME_TOKEN=replace-with-a-different-32-character-runtime-token
OMAI_ADK_PROVIDERS_FILE=./config/providers.example.json
# OMAI_ADK_TLS_CERT=/run/secrets/adk.crt
# OMAI_ADK_TLS_KEY=/run/secrets/adk.key
# OMAI_ADK_CLIENT_CA=/run/secrets/runtime-client-ca.crt
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Separate horizontally scalable voice gateway.
OMAI_VOICE_ADDR=127.0.0.1:8791
OMAI_VOICE_METRICS_ADDR=127.0.0.1:9092
OMAI_CONTROL_URL=http://127.0.0.1:8787
GOOGLE_API_KEY=replace-with-provider-key
OMAI_VOICE_MODEL=gemini-3.1-flash-live-preview
OMAI_VOICE_IDLE_TIMEOUT=10m
OMAI_VOICE_HEARTBEAT=15s
OMAI_VOICE_TOOL_TIMEOUT=65s

# Production identity. Do not expose either secret through VITE_* variables.
# OMAI_JWT_HS256_SECRET=replace-with-at-least-32-random-characters
# OMAI_JWT_ISSUER=https://identity.example.com
# OMAI_JWT_AUDIENCE=omai-api

# Production TLS. Terminating TLS at a trusted reverse proxy is also supported.
# OMAI_TLS_CERT=/run/secrets/tls.crt
# OMAI_TLS_KEY=/run/secrets/tls.key
# OMAI_ALLOW_INSECURE=false
