{
  "name": "@omai/sdk-web",
  "version": "1.1.0",
  "description": "Typed browser SDK for the OMAI Go control plane",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./proto": "./src/proto.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:"
  }
}
