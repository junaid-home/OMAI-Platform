# syntax=docker/dockerfile:1.7

FROM node:24.19.0-bookworm-slim AS node-toolchain
FROM golang:1.26.6-bookworm AS audit

ARG BUF_VERSION=v1.72.0
ARG BUN_VERSION=1.3.14
ARG STATICCHECK_VERSION=v0.7.0
ARG GOSEC_VERSION=v2.28.0
ARG GOVULNCHECK_VERSION=v1.7.0
ARG GRPCURL_VERSION=v1.9.3

ENV DEBIAN_FRONTEND=noninteractive \
    GOTOOLCHAIN=local \
    CGO_ENABLED=1 \
    GOMODCACHE=/go/pkg/mod \
    GOCACHE=/go/cache/build \
    NPM_CONFIG_CACHE=/cache/npm \
    XDG_CACHE_HOME=/cache/xdg \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY --from=node-toolchain /usr/local/ /usr/local/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash build-essential ca-certificates curl git python3 ripgrep unzip && \
    npm install --global "bun@${BUN_VERSION}" && \
    GOBIN=/usr/local/bin go install "github.com/bufbuild/buf/cmd/buf@${BUF_VERSION}" && \
    GOBIN=/usr/local/bin go install "honnef.co/go/tools/cmd/staticcheck@${STATICCHECK_VERSION}" && \
    GOBIN=/usr/local/bin go install "github.com/securego/gosec/v2/cmd/gosec@${GOSEC_VERSION}" && \
    GOBIN=/usr/local/bin go install "golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}" && \
    GOBIN=/usr/local/bin go install "github.com/fullstorydev/grpcurl/cmd/grpcurl@${GRPCURL_VERSION}" && \
    rm -rf /root/.cache/go-build /root/.npm /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .

# Every project dependency is resolved while the image is built. The live
# audit can therefore run without mutating the host toolchain or source tree.
RUN cd services/omai-control-plane && \
    go mod download && \
    go mod verify && \
    cd integration/adk && \
    go mod download && \
    go mod verify
RUN cd services/omai-control-plane/sdk/typescript && \
    npm ci --no-audit --no-fund
RUN bun install --frozen-lockfile
RUN bunx playwright install --with-deps chromium

LABEL org.opencontainers.image.title="OMAI complete E2E audit toolchain" \
      org.opencontainers.image.description="Pinned Go, Buf, Bun, Node, scanners, browser and project dependencies"

ENTRYPOINT ["/workspace/RUN_LIVE_AUDIT.sh"]
CMD ["--requests", "500", "--concurrency", "32"]
