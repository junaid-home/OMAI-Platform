# OMAI development stack
OMAI_FRONTEND_PORT=4444
OMAI_WORKSPACES_DIR=/absolute/path/to/workspaces
OMAI_DEV_TOKEN=replace-with-at-least-32-random-characters
OMAI_SERVICE_TOKEN=replace-with-a-different-32-character-service-token
OMAI_ADK_RUNTIME_TOKEN=replace-with-a-different-32-character-runtime-token
OMAI_EXECUTOR_TOKEN=replace-with-a-different-32-character-executor-token
OMAI_MAX_ARCHIVE_BYTES=209715200
OMAI_EXECUTOR_MAX_ARCHIVE_BYTES=209715200
OMAI_PREVIEW_PUBLIC_BASE_URL=http://localhost:8787
OMAI_PREVIEW_PUBLIC_URL_TEMPLATE=http://{id}.preview.localhost:8787/
GOOGLE_API_KEY=replace-with-provider-key
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Browser build-time connection. Production identity must be installed from
# the signed-in session rather than embedding a secret in VITE_* variables.
VITE_OMAI_API_BASE_URL=http://localhost:8787
VITE_OMAI_API_TOKEN=replace-with-at-least-32-random-characters
VITE_OMAI_VOICE_GATEWAY_URL=ws://localhost:8791
